#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>

/*
 * Position order (matches the matrix transform):
 *   0-11 row 0 | 12-23 row 1 | 24-35 row 2 | 36-47 row 3
 *   48-55 bottom row: LCTRL(48) LGUI(49) LALT(50) SPACE(51)  SPACE(52) RALT(53) RGUI(54) RCTRL(55)
 *   56-59 left DPAD, 60-63 right DPAD
 *
 * Hold both WIN keys together to get the Bluetooth layer.
 */

/ {
    combos {
        compatible = "zmk,combos";

        combo_bt_layer {
            timeout-ms = <50>;
            key-positions = <49 54>;
            bindings = <&mo 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp ESC            &kp N1    &kp N2    &kp N3    &kp N4   &kp N5       &kp N6  &kp N7  &kp N8     &kp N9   &kp N0    &kp BSPC
&kp TAB            &kp Q     &kp W     &kp E     &kp R    &kp T        &kp Y   &kp U   &kp I      &kp O    &kp P     &kp BSLH
&kp NON_US_BSLH    &kp A     &kp S     &kp D     &kp F    &kp G        &kp H   &kp J   &kp K      &kp L    &kp SEMI  &kp SQT
&kp LSHFT          &kp Z     &kp X     &kp C     &kp V    &kp B        &kp N   &kp M   &kp COMMA  &kp DOT  &kp FSLH  &kp RSHFT
&kp LCTRL  &kp LGUI  &kp LALT  &kp SPACE                              &kp SPACE  &kp RALT  &kp RGUI  &kp RCTRL
&kp HOME  &kp PG_UP  &kp PG_DN  &kp END                                &kp LEFT  &kp RIGHT  &kp DOWN  &kp UP
            >;
        };

        bluetooth_layer {
            bindings = <
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &bt BT_CLR  &out OUT_USB  &out OUT_BLE  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                                   &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans                                                   &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans                                                   &trans  &trans  &trans  &trans
            >;
        };
    };
};
